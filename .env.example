# OpenSky Network API configuration
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_BBOX_LAMIN=27.5
OPENSKY_BBOX_LOMIN=-14.0
OPENSKY_BBOX_LAMAX=36.5
OPENSKY_BBOX_LOMAX=-1.0
INGESTION_INTERVAL_SECONDS=10

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9096
KAFKA_TOPIC_TELEMETRY=aircraft-telemetry-raw
KAFKA_TOPIC_ANOMALIES=aircraft-anomalies
KAFKA_GROUP_ID=skypulse-lakehouse-group

# MinIO / S3 Lakehouse configuration
MINIO_ENDPOINT=localhost:9005
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
LAKEHOUSE_BUCKET_SILVER=lakehouse-silver
LAKEHOUSE_BUCKET_GOLD=lakehouse-gold
LAKEHOUSE_CHECKPOINT_DIR=lakehouse-checkpoints

# Stream Processing parameters
WINDOW_DURATION_MINUTES=5
SLIDE_DURATION_MINUTES=1
WATERMARK_DELAY_MINUTES=10
SPEED_CHANGE_ANOMALY_THRESHOLD_MPS=25.0
VERTICAL_RATE_ANOMALY_THRESHOLD_MPS=15.0

# Dashboard & Monitoring
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
